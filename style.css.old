body {
    background-color: #2a2e2f;
    color: whitesmoke;
    font-family: 'Verdana', sans-serif;
}

header {
    text-align: center;
}

button {
    padding-inline: 20px;
    padding-block: 12px;
    background-color: #473c73;
    border-radius: 10px;
    border-width: 0;
    color: white;
}

button:hover {
    color: white;
    background-color: #c07abc;
    transform: scale(1.05);
}

a {
    color: antiquewhite;
}

a:hover {
    color: #c07abc;
}

#weatherProperties {
    text-align: center;
    grid-row: 1;
}

#forecastsContainer {
    display: flex;
    justify-content: center;
    align-items: center;
}

#forecastContainer div {
    padding-block: 20px;
    padding-inline: 20px;
    margin: 30px;
    margin-inline: 70px;
    max-width: 4000px;
    height: fit-content;
    background-color: #6c7375;
    border-radius: 10px;
}

#forecastDump {
    background-color: white;
    color: black;
    border-radius: 10px;
    padding: 20px;
    margin: 10px;
    width: fit-content;
}

#preID {
    margin: 10px;
    margin-bottom: 20px;
}

.weatherimg {
    display: block;
    margin-left: auto;
    margin-right: auto;
    width: 15%;
    border-radius: 10px;
    max-height: 100px;
    max-width: 110px;
}

#forecastContainer h2 {
    text-align: center;
}